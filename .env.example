# Default demo: no API keys, no AWS calls.
HOUSEHOLD_AI_PROVIDER=mock

# To enable Bedrock, configure these in Vercel's secure environment settings.
# HOUSEHOLD_AI_PROVIDER=bedrock
# AWS_REGION=your-region
# BEDROCK_MODEL_ID=your-converse-compatible-model-or-inference-profile-id
# BEDROCK_REQUEST_LIMIT_PER_MINUTE=10
# Supply AWS_BEARER_TOKEN_BEDROCK or AWS credentials securely; no values belong here.
